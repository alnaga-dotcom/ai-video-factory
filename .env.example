# Bunny.net Storage
# Copy this file to .env locally and fill in real values.
# Never commit .env or access keys.
BUNNY_STORAGE_ZONE=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_CDN_BASE_URL=
# Optional. Leave blank for the default global storage endpoint.
BUNNY_STORAGE_HOST=

# Google Gemini API / Veo
# Create the key for the paid Gemini API project. Never commit the real key.
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-generate-preview
