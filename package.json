{
  "name": "ai-video-factory",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24" },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/**/*.test.mjs",
    "check": "npm run typecheck && npm test",
    "storage:test": "npm run build && node scripts/storage-test.mjs",
    "asset:publish-folder": "npm run build && node scripts/asset-publish-folder.mjs",
    "asset:review": "node scripts/asset-review.mjs",
    "asset:promote": "node scripts/asset-promote.mjs",
    "generated:approve": "node scripts/generated-asset-approve.mjs",
    "brand:publish": "npm run build && node scripts/sabra-brand-assets-publish.mjs",
    "intro:master": "npm run build && node scripts/sabra-intro-master.mjs",
    "sabra:dry-run": "npm run build && node scripts/sabra-dry-run.mjs",
    "gemini:test": "node scripts/gemini-connectivity-test.mjs",
    "sabra:veo-dry-run": "npm run build && node scripts/sabra-veo-payload-dry-run.mjs",
    "sabra:veo-generate": "npm run build && node scripts/sabra-veo-generate.mjs",
    "video:preserve": "npm run build && node scripts/preserve-gemini-video.mjs",
    "ep001:dry-run": "npm run build && node scripts/ep001-dry-run.mjs",
    "milestone:dry-run": "npm run build && node scripts/milestone-dry-run.mjs",
    "intro:dry-run": "npm run build && node scripts/sabra-intro-dry-run.mjs",
    "intro:produce": "npm run build && node scripts/sabra-intro-produce.mjs"
  },
  "dependencies": { "@google/genai": "^1.0.0" },
  "devDependencies": { "@types/node": "^24.0.0", "typescript": "^5.9.0" }
}
